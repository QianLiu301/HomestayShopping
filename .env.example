# 复制此文件为 .env 并填写实际值

# Flask配置
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this

# 数据库连接 (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:xxxxx@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT密钥
JWT_SECRET_KEY=your-jwt-secret-key-change-this

# 跨域允许的域名（生产环境设置具体域名）
CORS_ORIGINS=*

# 管理员账号（启动时自动创建/更新）
ADMIN_USERNAME=homestay
ADMIN_PASSWORD=your-password-here

# Cloudflare R2 对象存储（可选，未配置时使用本地存储）
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=homestay
R2_PUBLIC_URL=https://img.your-domain.com

# 邮件通知（新订单通知，可选）
MAIL_SERVER=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=your-smtp-password
MAIL_NOTIFY_TO=admin@example.com
